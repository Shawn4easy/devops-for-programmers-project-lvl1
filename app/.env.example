# Диалект базы. sqlite запускает приложение без внешней базы, postgres нужен
# для docker compose и деплоя.
DATABASE_CLIENT=postgres

# Строка подключения целиком либо части по отдельности ниже.
# DATABASE_URL=postgres://postgres:password@db:5432/postgres

DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=password
